{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.12.0/.schema/devbox.schema.json",
  "packages": [
    "php@latest",
    "php83Packages.composer@latest",
    "nodejs@18",
    "prek@latest"
  ],
  "include": ["plugin:php"],
  "env": {
    "DEVBOX_COREPACK_ENABLED": "true"
  },
  "shell": {
    "init_hook": ["test -e .envrc.private || cp .envrc.example .envrc.private"],
    "scripts": {
      "verify": ["prek run --all-files --refresh"]
    }
  }
}
